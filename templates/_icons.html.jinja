{# Inline SVG icons. Kept inline rather than as an icon font or sprite sheet so
   they inherit currentColor and need no extra request. All are decorative —
   the adjacent text carries the meaning — hence aria-hidden. #}

{% macro icon_star() -%}
<svg class="icon icon--star" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true" focusable="false"><path d="m12 3.4 2.6 5.6 6 .8-4.4 4.2 1.1 6.1L12 17.2 6.7 20.1l1.1-6.1L3.4 9.8l6-.8Z"/></svg>
{%- endmacro %}

{% macro icon_bed() -%}
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 18V7"/><path d="M3 13h18v5"/><path d="M21 18v-4a3 3 0 0 0-3-3h-7v2"/><circle cx="7.5" cy="9.5" r="2"/></svg>
{%- endmacro %}

