<!-- GENERATED FILE — edit templates/compare.html.jinja + data/overview.json + data/reference.json, then rerun scripts/generate_pages.py -->
{% from "_nav.html.jinja" import render_nav %}
{% from "_units.html.jinja" import unit %}
<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Compare routes — Pacific Coast Bike Tour</title>
  <link rel="stylesheet" href="{{ asset('css/main.css') }}">
  <meta name="description" content="How our planned Los Altos-to-Los Angeles route compares to Adventure Cycling's Pacific Coast Section 4 reference track.">

  <link rel="icon" href="icon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#F2EFE9">
  <script>
    try {
      if (localStorage.getItem("pcgf-units") === "metric") document.documentElement.classList.add("metric");
    } catch (e) {}
  </script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
</head>

<body>

  <a class="skip-link" href="#main">Skip to main content</a>

  <div class="top-band">
    <header>
      <h1 class="site-title"><a href="index.html">Pacific Coast Bike Tour</a></h1>
      <p class="site-tagline">The "LA to LA" ride: Los Altos to Los Angeles.</p>
    </header>

    {{ render_nav('compare') }}
  </div>

  <main id="main">

    <div class="day-title">
      <div class="day-title__number">
        <span class="day-title__label">Route comparison</span>
      </div>
      <h2 class="day-title__route">
        Our route vs. the reference
      </h2>
    </div>

    <p class="lede">Our plan is inspired by Adventure Cycling's <strong>{{ reference.name }}</strong> track but isn't an exact match. Toggle each layer to see where they diverge.</p>

    <div class="compare-toggles" role="group" aria-label="Toggle route layers">
      <label class="compare-toggle compare-toggle--planned">
        <input type="checkbox" id="toggle-planned" checked>
        <span class="compare-toggle__swatch"></span>
        Our planned route ({{ unit(planned.distance_mi, 'mi', planned.distance_km, 'km') }})
      </label>
      <label class="compare-toggle compare-toggle--reference">
        <input type="checkbox" id="toggle-reference" checked>
        <span class="compare-toggle__swatch"></span>
        {{ reference.name }} ({{ unit(reference.distance_mi, 'mi', reference.distance_km, 'km') }})
      </label>
    </div>

    <div class="route-section route-section--single">
      <figure class="map-card map-card--tall">
        <div id="map" class="map-card__map" role="region" aria-label="Map comparing our planned route to the reference track"></div>
        <figcaption class="map-card__caption">Our planned route vs. the Adventure Cycling reference track it's loosely based on.</figcaption>
      </figure>
    </div>

  </main>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script>
    window.__planned_days = {{ planned_days_json|safe }};
    window.__reference_route = {{ reference_route_json|safe }};
  </script>
  <script src="{{ asset('js/config.js') }}"></script>
  <script src="{{ asset('js/basemap.js') }}"></script>
  <script src="{{ asset('js/compare.js') }}"></script>
  <script src="{{ asset('js/units.js') }}"></script>
</body>

</html>
